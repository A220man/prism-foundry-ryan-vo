# App
APP_NAME=prism-foundry
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/prism.db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/prism
OIDC_CLIENT_ID=prism-frontend
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid profile email roles

# LLM Providers (choose one)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=30.0

# Kronos Model
KRONOS_MODEL_PATH=
KRONOS_TOKENIZER_PATH=

# Demo mode (localhost only)
DEMO_MODE=true